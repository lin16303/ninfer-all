{
  "name": "ninfer-all CUDA Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "gpu": "optional"
  },
  "runArgs": [
    "--gpus", "all"
  ],
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
